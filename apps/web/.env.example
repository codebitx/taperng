# X Layer 主网(196) 生产配置；对外发布统一以主网为准。
# anvil/testnet 不参与前端运行时，仅供内部合约调试（见 taperng/contracts/anvil/）。
NEXT_PUBLIC_CHAIN_ID=196
NEXT_PUBLIC_RPC_URL=https://rpc.xlayer.tech
NEXT_PUBLIC_LOTTERY_ADDRESS=
NEXT_PUBLIC_TAPE_RNG_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=0
# drand for the web demo; mock is for contract tests only; none = blockhash-only
NEXT_PUBLIC_BEACON_MODE=drand
# tapeout for mainnet; mock on testnet
NEXT_PUBLIC_CIRCUIT_MODE=tapeout
DATABASE_URL=./data/taperng-mainnet.sqlite

# === 运维脚本（apps/web/scripts/mainnet-demo.ts / seed-mainnet.ts，可选） ===
# 均有默认值；MAINNET_PK 不设置时会回退读取 ../../contracts/.env 的 PRIVATE_KEY。
# MAINNET_RPC=https://rpc.xlayer.tech
# MAINNET_LOTTERY=0xb76AE4c893982E4D25ADC4888c8784369Fbd578D
# MAINNET_TAPERNG=0x3fadc14280A850dd31De8c7A83172Ded8BE717Ce
# MAINNET_VERSION=A
# MAINNET_PK=
