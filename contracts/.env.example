# Foundry 部署/测试环境变量模板。复制为 .env 后填写（.env 已被 .gitignore 忽略）。
# forge 会自动加载本目录的 .env。

# === 部署（script/Deploy.s.sol） ===
# 专用部署钱包私钥。不要把真实私钥放进仓库或聊天记录；
# 推荐用 cast wallet import taperng-deployer --interactive 后改用 --account taperng-deployer。
PRIVATE_KEY=

# X Layer 测试网 RPC（部署目标链，见 README「部署」一节）
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon

# drand | mock | none
BEACON_MODE=drand
# mock | real（测试网用 mock；主网 196 可用真实 Keccak Core，需配 CIRCUIT_ID）
CPU_MODE=mock

# CPU_MODE=real 时必填（X Layer 主网真实 Keccak Core circuitId=3）
CIRCUIT_ID=

# CPU_MODE=mock 时可选：mock 信标的 genesis 时间与出轮周期（秒）
MOCK_BEACON_GENESIS=
MOCK_BEACON_PERIOD=60

# === 测试 ===
# RUN_FORK=true 的主网 fork 回归测试用；默认官方主网 RPC
XLAYER_RPC=https://rpc.xlayer.tech
